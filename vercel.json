{
  "functions": {
    "api/index.js": { "includeFiles": "data/**", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ],
  "redirects": [
    { "source": "/data/:path*", "destination": "/", "permanent": false },
    { "source": "/lib/:path*", "destination": "/", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/", "permanent": false }
  ]
}
